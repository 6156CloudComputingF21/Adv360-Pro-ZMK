macro_next: macro_next{
compatible = "zmk,behavior-macro";
label = "macro_next";
#binding-cells = <0>;
bindings = <&macro_press &kp LGUI>, <&macro_tap &kp TAB>, <&macro_release &kp LGUI>; 
};
macro_prev: macro_prev{
    compatible = "zmk,behavior-macro";
    label = "macro_prev";
    #binding-cells = <0>;
    bindings = <&macro_press &kp LGUI>, <&macro_press &kp LEFT_SHIFT>, <&macro_tap &kp TAB>, <&macro_release &kp LGUI>, <&macro_release &kp LEFT_SHIFT>; 
};
macro_n_w: macro_n_w {
compatible = "zmk,behavior-macro";
label = "macro_n_w";
#binding-cells = <0>;
bindings = <&macro_press &kp LGUI>, <&macro_tap &kp GRAVE>, <&macro_release &kp LGUI>; 
};
